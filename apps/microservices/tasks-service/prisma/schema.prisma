generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id        String   @id
  name      String
  email     String
  createdAt DateTime
}
